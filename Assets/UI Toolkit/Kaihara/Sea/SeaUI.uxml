<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Kaihara/Sea/SeaUI.uss?fileID=7433441132597879392&amp;guid=1ef4e93601e848d458abaaf02abadaef&amp;type=3#SeaUI"/>
    <Style src="project://database/Assets/UI%20Toolkit/Kaihara/RiverStatusUI.uss?fileID=7433441132597879392&amp;guid=77c93fea1c9574e428efb117af51f4f4&amp;type=3#RiverStatusUI"/>
    <Style src="project://database/Assets/UI%20Toolkit/Kaihara/Sea/SeaLayout.uss?fileID=7433441132597879392&amp;guid=bf2076ba13b3bc5498dbcfdd75837439&amp;type=3#SeaLayout"/>
    <Style src="project://database/Assets/UI%20Toolkit/Kaihara/MaleIllust.uss?fileID=7433441132597879392&amp;guid=d8773a28e54b5b9409d22a37e789129c&amp;type=3#MaleIllust"/>
    <ui:VisualElement name="base" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Textures/%E6%B5%B7%E8%83%8C%E6%99%AF.png?fileID=2800000&amp;guid=84672250071a2d24b8df1a352e39d405&amp;type=3#海背景&quot;);">
        <ui:VisualElement name="illust" class="male-illustration_base male-illust">
            <ui:VisualElement class="male-illustration_body-paint"/>
            <ui:VisualElement class="male-illustration_body-base"/>
            <ui:VisualElement name="VisualElement" class="male-illustration_pale" style="flex-grow: 1;"/>
            <ui:VisualElement class="male-illustration_mouth"/>
            <ui:VisualElement name="VisualElement" class="male-illustration_eye-paint"/>
            <ui:VisualElement class="male-illustration_eye-line"/>
            <ui:VisualElement name="VisualElement" class="male-illustration_hair-paint"/>
            <ui:VisualElement class="male-illustration_hair-line" style="flex-grow: 1;"/>
            <ui:VisualElement name="VisualElement" class="male-illustration_eyebrow"/>
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Textures/%E6%B5%B7%E8%83%8C%E6%99%AF.png?fileID=2800000&amp;guid=84672250071a2d24b8df1a352e39d405&amp;type=3#海背景&quot;); -unity-background-image-tint-color: rgba(255, 255, 255, 0.12);"/>
        <ui:VisualElement name="statesbar" class="main-salmon-statusbar">
            <ui:VisualElement>
                <ui:Label text="推進力" class="main-salmon-status_name--swim"/>
                <ui:Label text="20" class="main-salmon-status_value"/>
                <ui:Label text="動きやすくなって&#10;疲れにくくなる" picking-mode="Ignore" class="main-salmon-status_status-information"/>
                <ui:Label text="label" class="main-salmon-status_increace"/>
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label text="跳躍力" class="main-salmon-status_name--swim"/>
                <ui:Label text="Label" class="main-salmon-status_value"/>
                <ui:Label text="ジャンプで&#10;疲れにくくなる" picking-mode="Ignore" class="main-salmon-status_status-information" style="-unity-text-align: middle-center;"/>
                <ui:Label text="label" class="main-salmon-status_increace"/>
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label text="持久力" class="main-salmon-status_name--swim"/>
                <ui:Label text="Label" class="main-salmon-status_value"/>
                <ui:Label text="スタミナが&#10;たくさんもてる" picking-mode="Ignore" class="main-salmon-status_status-information"/>
                <ui:Label text="label" class="main-salmon-status_increace"/>
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label text="攻撃力" class="main-salmon-status_name--swim"/>
                <ui:Label text="Label" class="main-salmon-status_value"/>
                <ui:Label text="小魚などに&#10;よりダメージが&#10;与えられる" picking-mode="Ignore" class="main-salmon-status_status-information"/>
                <ui:Label text="label" class="main-salmon-status_increace"/>
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label text="知力" class="main-salmon-status_name--swim"/>
                <ui:Label text="Label" class="main-salmon-status_value"/>
                <ui:Label text="育成中に&#10;強くなりやすい" picking-mode="Ignore" class="main-salmon-status_status-information"/>
                <ui:Label text="label" class="main-salmon-status_increace"/>
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label text="カラー" class="main-salmon-status_name--court"/>
                <ui:Label text="Label" class="main-salmon-status_value"/>
                <ui:Label text="体色が変わる" picking-mode="Ignore" class="main-salmon-status_status-information"/>
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label text="サイズ" class="main-salmon-status_name--court"/>
                <ui:Label text="Label" class="main-salmon-status_value"/>
                <ui:Label text="大きさが変わる" picking-mode="Ignore" class="main-salmon-status_status-information"/>
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label text="形" class="main-salmon-status_name--court"/>
                <ui:Label text="Label" class="main-salmon-status_value"/>
                <ui:Label text="Label" picking-mode="Ignore" class="main-salmon-status_status-information"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="トレーニング" name="trainingbutton" class="training-button"/>
        <ui:Button text="ランダム&#10;イベント" name="randomeventbutton" selectable="false" focusable="true" enable-rich-text="true" class="random-event-button"/>
        <ui:Label text="Label" name="turn" class="turn-ui"/>
        <ui:VisualElement name="riverinformation" class="next-river-information next-river" style="flex-grow: 1;">
            <ui:VisualElement name="riverstatus" style="flex-grow: 1; transition-duration: 0.1s;">
                <ui:VisualElement style="flex-grow: 1;">
                    <ui:Label text="Label" class="next-river-information_status_name"/>
                    <ui:VisualElement class="next-river-information_status_value"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1;">
                    <ui:Label text="Label" class="next-river-information_status_name"/>
                    <ui:VisualElement class="next-river-information_status_value"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1;">
                    <ui:Label text="Label" class="next-river-information_status_name"/>
                    <ui:VisualElement class="next-river-information_status_value"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1;">
                    <ui:Label text="Label" class="next-river-information_status_name"/>
                    <ui:VisualElement class="next-river-information_status_value"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1;">
                    <ui:Label text="Label" class="next-river-information_status_name"/>
                    <ui:VisualElement class="next-river-information_status_value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="&gt;" name="riverbutton"/>
            <ui:Label text="Label" name="rivername"/>
        </ui:VisualElement>
        <ui:VisualElement name="trainningtab" class="training-tab">
            <ui:Button text="推進力" name="Button" class="training-tab_training-button"/>
            <ui:Button text="跳躍力" name="Button" class="training-tab_training-button"/>
            <ui:Button text="持久力" name="Button" class="training-tab_training-button"/>
            <ui:Button text="攻撃力" name="Button" class="training-tab_training-button"/>
            <ui:Button text="知力" name="Button" class="training-tab_training-button"/>
            <ui:Button text="X" name="close" class="training-tab_cancel-button"/>
        </ui:VisualElement>
        <ui:VisualElement name="randomtab" class="random-event-tab" style="flex-grow: 1; width: 48%; left: 26%;">
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; width: 130%; position: absolute; height: 100%; left: -15%;"/>
            <ui:Button text="Button" class="random-event-tab_random-event-button"/>
            <ui:Button text="Button" class="random-event-tab_random-event-button"/>
            <ui:Button text="Button" class="random-event-tab_random-event-button"/>
            <ui:Button text="X" class="random-event-tab_cancel-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
