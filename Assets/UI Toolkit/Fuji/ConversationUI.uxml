<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ConversationContainer" style="flex-grow: 1; height: auto; width: auto;">
        <ui:Image name="BackGround" style="position: absolute; height: 885px; width: auto; top: 0; left: 0; background-color: rgb(130, 255, 145); bottom: 3px; right: -7px;"/>
        <ui:Image name="Image" style="position: absolute; height: 646px; width: 548px; top: 101px; left: 56px; background-color: rgb(255, 135, 0);"/>
        <ui:Image style="position: absolute; height: 672px; width: 550px; top: 115px; left: 941px; background-color: rgb(124, 255, 249);"/>
        <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; position: absolute; align-self: center; height: auto; width: auto; left: 0; top: 494px; right: 0; bottom: 0; margin-top: 14px; margin-right: 30px; margin-bottom: 14px; margin-left: 30px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(255, 255, 255, 0.65);">
            <ui:VisualElement name="TexyArea" style="flex-grow: 1; background-color: rgb(48, 48, 48); opacity: 1; margin-top: 16px; margin-right: 16px; margin-bottom: 16px; margin-left: 16px;">
                <ui:Label text="Label" name="DialogueText" style="height: 333px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; bottom: 0; right: 0; top: 0; left: 0; padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px; color: rgb(255, 255, 255); width: auto; font-size: 41px; position: relative;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Image name="SpeakerArea" style="height: auto; width: auto; background-color: rgba(255, 255, 255, 0.65); position: absolute; top: 465px; left: 30px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; right: 1200px; bottom: 380px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; opacity: 1;">
            <ui:Label text="Label" name="Speaker" style="margin-top: 2px; margin-right: 5px; margin-bottom: 5px; margin-left: 19px; padding-top: 3px; padding-right: 3px; padding-bottom: 3px; padding-left: 3px; font-size: 37px; height: 38px;"/>
        </ui:Image>
        <ui:Button text="" name="NextButton" style="position: absolute; height: auto; width: auto; background-color: rgba(255, 255, 255, 0); bottom: 0; right: 0; top: 0; left: 0;"/>
    </ui:VisualElement>
</ui:UXML>
