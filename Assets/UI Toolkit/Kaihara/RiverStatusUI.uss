

.next-river-information {
    flex-grow: 0;
    background-color: rgb(190, 254, 255);
    position: absolute;
    flex-shrink: 0;
    flex-direction: row-reverse;
    border-left-color: rgb(38, 37, 114);
    border-right-color: rgb(38, 37, 114);
    border-top-color: rgb(38, 37, 114);
    border-bottom-color: rgb(38, 37, 114);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.next-river-information > Label {
    width: 85%;
    background-color: rgb(190, 254, 255);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: middle-center;
    font-size: 60px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-left-color: rgb(38, 37, 114);
    border-right-color: rgb(38, 37, 114);
    border-top-color: rgb(38, 37, 114);
    border-bottom-color: rgb(38, 37, 114);
}

.next-river-information > Button {
    flex-grow: 1;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    translate: 0 0%;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
    font-size: 50px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-left-color: rgb(38, 37, 114);
    border-right-color: rgb(38, 37, 114);
    border-top-color: rgb(38, 37, 114);
    border-bottom-color: rgb(38, 37, 114);
}

.next-river-information > VisualElement {
    flex-grow: 0;
    position: absolute;
    flex-shrink: 0;
    width: 50%;
    height: 300%;
    translate: 0 -135%;
    background-color: rgb(190, 254, 255);
    top: 100%;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
    border-left-color: rgb(38, 37, 114);
    border-right-color: rgb(38, 37, 114);
    border-top-color: rgb(38, 37, 114);
    border-bottom-color: rgb(38, 37, 114);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.next-river-information.is-open > VisualElement {
    translate: 0 0%;
}

.next-river-information > Button:hover {
    scale: 1.05 1.05;
}

.next-river-information > Button:active {
    scale: 0.97 0.97;
}

.next-river-information_status_name {
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: middle-center;
    width: 27%;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(38, 37, 114);
    border-right-color: rgb(38, 37, 114);
    border-top-color: rgb(38, 37, 114);
    border-bottom-color: rgb(38, 37, 114);
    font-size: 25px;
}

.next-river-information_status_value {
    flex-grow: 0;
    margin-top: 1%;
    margin-right: 1%;
    margin-bottom: 1%;
    margin-left: 1%;
    background-color: rgb(40, 47, 120);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(38, 37, 114);
    border-right-color: rgb(38, 37, 114);
    border-top-color: rgb(38, 37, 114);
    border-bottom-color: rgb(38, 37, 114);
    flex-shrink: 0;
    width: 70%;
}

.next-river-information > VisualElement > VisualElement {
    flex-grow: 1;
    flex-direction: row;
}
